{
  "schema_version": "tshirt-construction-trace-1.0",
  "scope": "freesewing_teagan_basic_tshirt_only",
  "mode": "pattern-only",
  "selection_objective": "edge-primary",
  "seed": 2028,
  "width": 128,
  "heads": 4,
  "layers": 4,
  "feedforward_multiplier": 3,
  "dropout": 0.1,
  "maximum_edges": 48,
  "batch_size": 48,
  "epochs": 80,
  "learning_rate": 0.0003,
  "weight_decay": 0.001,
  "augmentation": {
    "cyclic_shift": true,
    "reverse_probability": 0.5,
    "rotation_degrees": 180.0,
    "minimum_scale": 0.8,
    "maximum_scale": 1.2
  },
  "loss_weights": {
    "edge": 1.0,
    "panel": 0.5,
    "landmark_existence": 0.5,
    "landmark_coordinate": 2.0
  },
  "split_contract": {
    "training": ["train"],
    "validation_only": ["validation_body", "validation_design", "validation_double"],
    "frozen_test": [
      "test_body",
      "test_design",
      "test_double",
      "test_design_on_validation_body",
      "test_body_on_validation_design"
    ]
  },
  "target_contract": {
    "landmarks": ["FNP", "BNP", "SNP", "SP"],
    "landmark_decoding": "DERIVE_FROM_PREDICTED_SEMANTIC_EDGE_JUNCTIONS; neural coordinate head is diagnostic only",
    "BP": "UNAVAILABLE_NOT_A_TRAIN_TARGET",
    "darts": "NOT_APPLICABLE_FALSE_POSITIVES_ONLY",
    "operation_DAG": "NOT_AVAILABLE_FROM_NAMED_OUTPUT_DOMAIN"
  }
}
